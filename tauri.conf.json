{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitCraft",
  "identifier": "dev.gitcraft.desktop",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitCraft",
        "width": 930,
        "height": 669,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A graphical Git client",
    "longDescription": "GitCraft is a desktop Git client with a commit graph, staging, interactive rebase, a merge tool, GitHub and GitLab pull requests, and AI helpers.",
    "license": "GPL-3.0-only",
    "macOS": { "infoPlist": "installer/finder-services.plist" },
    "windows": {
      "wix": {
        "fragmentPaths": ["installer/windows-explorer.wxs"],
        "componentRefs": ["GitCraftExplorerCommands"]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer/windows-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "git (>= 1:2.38)"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["gitcraft"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1REM1OUYyQzlEQTg1NTkKUldSWmhkcko4bG5jOVcrNUlmaTdYdURnOHlFMkMxYTdGK2h3TnphbWpQMitXU3dDMWNtYjFPS00K",
      "endpoints": [
        "https://github.com/MystifiedSky/GitCraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
