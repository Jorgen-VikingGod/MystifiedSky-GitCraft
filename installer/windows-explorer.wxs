<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="GitCraftExplorerCommands" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\GitCraft" Type="string" Value="Open in GitCraft" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\GitCraft\command" Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\GitCraft" Type="string" Value="Open in GitCraft" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\GitCraft\command" Type="string" Value="&quot;[!Path]&quot; &quot;%V&quot;" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
